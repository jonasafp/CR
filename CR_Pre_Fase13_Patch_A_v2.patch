+export interface PrinterOption {
+  value: string;
+  label: string;
+}
+
+type DesktopPrintingBridge = {
+  getPrinters?: () => Promise<Array<{ name: string; displayName?: string }>>;
+};
+
+declare global {
+  interface Window {
+    gestorFacilPrinting?: DesktopPrintingBridge;
+  }
+}
+
+const systemDefault: PrinterOption = {
+  value: "system-default",
+  label: "Impressora escolhida no diálogo do sistema",
+};
+
+export const printerService = {
+  async list(): Promise<PrinterOption[]> {
+    const printers = await window.gestorFacilPrinting?.getPrinters?.();
+
+    if (!printers?.length) {
+      return [systemDefault];
+    }
+
+    return [
+      systemDefault,
+      ...printers.map((printer) => ({
+        value: printer.name,
+        label: printer.displayName || printer.name,
+      })),
+    ];
+  },
+};
diff --git a/supabase/functions/quick-switch-user/index.ts b/supabase/functions/quick-switch-user/index.ts
new file mode 100644
index 0000000..c9be359
--- /dev/null
+++ b/supabase/functions/quick-switch-user/index.ts
@@ -0,0 +1,107 @@
+import "jsr:@supabase/functions-js/edge-runtime.d.ts";
+import { createClient } from "npm:@supabase/supabase-js@2.116.0";
+
+const corsHeaders = {
+  "Access-Control-Allow-Origin": "*",
+  "Access-Control-Allow-Headers": "authorization, apikey, content-type, x-client-info",
+};
+
+function json(body: unknown, status = 200) {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { ...corsHeaders, "Content-Type": "application/json" },
+  });
+}
+
+Deno.serve(async (request) => {
+  if (request.method === "OPTIONS") {
+    return new Response("ok", { headers: corsHeaders });
+  }
+
+  if (request.method !== "POST") {
+    return json({ error: "Método não permitido." }, 405);
+  }
+
+  try {
+    const authorization = request.headers.get("Authorization");
+    const token = authorization?.replace(/^Bearer\s+/i, "");
+    const supabaseUrl = Deno.env.get("SUPABASE_URL");
+    const anonKey = Deno.env.get("SUPABASE_ANON_KEY");
+    const serviceRoleKey = Deno.env.get("SUPABASE_SERVICE_ROLE_KEY");
+
+    if (!token || !supabaseUrl || !anonKey || !serviceRoleKey) {
+      return json({ error: "Sessão ou configuração indisponível." }, 401);
+    }
+
+    const admin = createClient(supabaseUrl, serviceRoleKey, {
+      auth: { autoRefreshToken: false, persistSession: false },
+    });
+    const { data: callerData, error: callerError } =
+      await admin.auth.getUser(token);
+
+    if (callerError || !callerData.user) {
+      return json({ error: "Sessão inválida ou expirada." }, 401);
+    }
+
+    const body = await request.json();
+    const companyId = String(body.companyId ?? "");
+    const internalCode = Number(body.internalCode);
+    const password = String(body.password ?? "");
+
+    if (!companyId || !Number.isSafeInteger(internalCode) || internalCode < 1) {
+      return json({ error: "Informe um código interno válido." }, 400);
+    }
+
+    if (!password) {
+      return json({ error: "Informe a senha do funcionário." }, 400);
+    }
+
+    const { data: callerMembership } = await admin
+      .from("company_members")
+      .select("id")
+      .eq("company_id", companyId)
+      .eq("user_id", callerData.user.id)
+      .eq("active", true)
+      .maybeSingle();
+
+    if (!callerMembership) {
+      return json({ error: "Seu acesso a esta empresa não está ativo." }, 403);
+    }
+
+    const { data: target, error: targetError } = await admin
+      .from("company_members")
+      .select("user_id, email, full_name, active")
+      .eq("company_id", companyId)
+      .eq("internal_code", internalCode)
+      .maybeSingle();
+
+    if (targetError || !target?.active || !target.email) {
+      return json({ error: "Código ou senha inválidos." }, 401);
+    }
+
+    const authClient = createClient(supabaseUrl, anonKey, {
+      auth: { autoRefreshToken: false, persistSession: false },
+    });
+    const { data: signInData, error: signInError } =
+      await authClient.auth.signInWithPassword({
+        email: target.email,
+        password,
+      });
+
+    if (
+      signInError ||
+      !signInData.session ||
+      signInData.user.id !== target.user_id
+    ) {
+      return json({ error: "Código ou senha inválidos." }, 401);
+    }
+
+    return json({
+      accessToken: signInData.session.access_token,
+      refreshToken: signInData.session.refresh_token,
+      employeeName: target.full_name ?? target.email,
+    });
+  } catch {
+    return json({ error: "Não foi possível trocar o usuário." }, 500);
+  }
+});
diff --git a/supabase/migrations/20261017090000_add_employee_codes_and_sale_sellers.sql b/supabase/migrations/20261017090000_add_employee_codes_and_sale_sellers.sql
new file mode 100644
index 0000000..3083089
--- /dev/null
+++ b/supabase/migrations/20261017090000_add_employee_codes_and_sale_sellers.sql
@@ -0,0 +1,130 @@
+alter table public.company_members
+  add column if not exists internal_code bigint;
+
+with numbered as (
+  select
+    id,
+    row_number() over (
+      partition by company_id
+      order by
+        case when role = 'owner' then 0 else 1 end,
+        created_at,
+        id
+    ) as code
+  from public.company_members
+)
+update public.company_members cm
+set internal_code = numbered.code
+from numbered
+where numbered.id = cm.id
+  and cm.internal_code is null;
+
+create table if not exists private.company_employee_counters (
+  company_id uuid primary key references public.companies(id) on delete cascade,
+  next_code bigint not null check (next_code > 0)
+);
+
+insert into private.company_employee_counters(company_id, next_code)
+select company_id, coalesce(max(internal_code), 0) + 1
+from public.company_members
+group by company_id
+on conflict (company_id) do update
+set next_code = greatest(
+  private.company_employee_counters.next_code,
+  excluded.next_code
+);
+
+create or replace function private.assign_company_member_code()
+returns trigger
+language plpgsql
+security definer
+set search_path = ''
+as $$
+begin
+  if new.internal_code is null then
+    insert into private.company_employee_counters(company_id, next_code)
+    values (new.company_id, 2)
+    on conflict (company_id) do update
+      set next_code = private.company_employee_counters.next_code + 1
+    returning next_code - 1 into new.internal_code;
+  end if;
+
+  return new;
+end;
+$$;
+
+drop trigger if exists assign_company_member_code
+  on public.company_members;
+
+create trigger assign_company_member_code
+before insert on public.company_members
+for each row execute function private.assign_company_member_code();
+
+alter table public.company_members
+  alter column internal_code set not null;
+
+create unique index if not exists company_members_company_internal_code_idx
+  on public.company_members(company_id, internal_code);
+
+alter table public.sales
+  add column if not exists seller_name text;
+
+update public.sales s
+set seller_name = coalesce(
+  nullif(trim(cm.full_name), ''),
+  nullif(trim(cm.email), ''),
+  'Usuário do sistema'
+)
+from public.company_members cm
+where cm.company_id = s.company_id
+  and cm.user_id = s.created_by
+  and s.seller_name is null;
+
+update public.sales
+set seller_name = 'Usuário do sistema'
+where seller_name is null;
+
+alter table public.sales
+  alter column seller_name set default 'Usuário do sistema',
+  alter column seller_name set not null;
+
+create or replace function private.assign_sale_seller()
+returns trigger
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  v_user_id uuid := coalesce(new.created_by, (select auth.uid()));
+begin
+  new.created_by := v_user_id;
+
+  select coalesce(
+    nullif(trim(cm.full_name), ''),
+    nullif(trim(cm.email), ''),
+    'Usuário do sistema'
+  )
+  into new.seller_name
+  from public.company_members cm
+  where cm.company_id = new.company_id
+    and cm.user_id = v_user_id
+    and cm.active
+  limit 1;
+
+  new.seller_name := coalesce(new.seller_name, 'Usuário do sistema');
+  return new;
+end;
+$$;
+
+drop trigger if exists assign_sale_seller on public.sales;
+
+create trigger assign_sale_seller
+before insert on public.sales
+for each row execute function private.assign_sale_seller();
+
+revoke all on table private.company_employee_counters
+  from public, anon, authenticated;
+revoke all on function private.assign_company_member_code()
+  from public, anon, authenticated;
+revoke all on function private.assign_sale_seller()
+  from public, anon, authenticated;
