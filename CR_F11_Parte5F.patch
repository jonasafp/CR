+import { supabase } from "../../../lib/supabase";
+import { getCurrentCompanyMembership } from "../../../services/auth/authService";
+import { settingsStorageService } from "../../../services/settings/settingsStorageService";
+import type { CancelPurchaseInput, CompletePurchaseInput, CreatePurchaseInput, Purchase, PurchaseItem, PurchaseSummary, UpdatePurchaseInput } from "../../../domain/purchases/Purchase";
+import type { PurchaseFilters } from "../../../domain/purchases/PurchaseFilters";
+import type { PaginatedResult } from "../../../types/Pagination";
+import type { Tables } from "../../../types/database.types";
+import type { PurchaseRepository } from "../PurchaseRepository";
+
+type PurchaseRow=Tables<"purchases">; type ItemRow=Tables<"purchase_items">;
+const round=(value:number)=>Math.round((value+Number.EPSILON)*100)/100;
+async function companyId(){const membership=await getCurrentCompanyMembership();if(!membership)throw new Error("Nenhuma empresa ativa foi encontrada.");return membership.company_id;}
+function mapItem(row:ItemRow):PurchaseItem{return {id:row.id,productId:row.product_id,productCode:row.product_code??"",productName:row.product_name,unit:row.unit as PurchaseItem["unit"],quantity:Number(row.quantity),unitCost:Number(row.unit_cost),total:Number(row.total)};}
+function mapPurchase(row:PurchaseRow,items:ItemRow[]):Purchase{return {id:row.id,number:`COM-${String(row.number).padStart(6,"0")}`,status:row.status==="draft"?"pending":row.status,supplierId:row.supplier_id??"",supplierName:row.supplier_name,documentNumber:row.document_number??"",purchaseDate:row.purchased_at??row.created_at,items:items.map(mapItem),subtotal:Number(row.subtotal),discount:Number(row.discount),freight:Number(row.freight),otherExpenses:Number(row.other_expenses),total:Number(row.total),notes:row.notes??"",createdAt:row.created_at,updatedAt:row.updated_at,completedAt:row.completed_at??undefined,cancelledAt:row.cancelled_at??undefined,cancellationReason:row.cancellation_reason??undefined,createdBy:row.created_by?"Usuário do sistema":"Sistema"};}
+async function loadAll():Promise<Purchase[]>{const id=await companyId();const [purchases,items]=await Promise.all([supabase.from("purchases").select("*").eq("company_id",id),supabase.from("purchase_items").select("*").eq("company_id",id)]);if(purchases.error)throw purchases.error;if(items.error)throw items.error;const grouped=new Map<string,ItemRow[]>();for(const item of items.data){const list=grouped.get(item.purchase_id)??[];list.push(item);grouped.set(item.purchase_id,list);}return purchases.data.map(row=>mapPurchase(row,grouped.get(row.id)??[]));}
+function filtered(rows:Purchase[],filters?:Partial<PurchaseFilters>){const search=filters?.search?.trim().toLowerCase()??"";return rows.filter(p=>(!search||[p.number,p.supplierName,p.documentNumber,...p.items.map(i=>`${i.productCode} ${i.productName}`)].join(" ").toLowerCase().includes(search))&&(!filters?.status||filters.status==="all"||p.status===filters.status)&&(!filters?.supplierId||p.supplierId===filters.supplierId)&&(!filters?.dateFrom||p.purchaseDate.slice(0,10)>=filters.dateFrom)&&(!filters?.dateTo||p.purchaseDate.slice(0,10)<=filters.dateTo));}
+function summary(rows:Purchase[]):PurchaseSummary{const completed=rows.filter(p=>p.status==="completed"),total=round(completed.reduce((s,p)=>s+p.total,0));return {totalPurchases:rows.length,pendingPurchases:rows.filter(p=>p.status==="pending").length,completedPurchases:completed.length,cancelledPurchases:rows.filter(p=>p.status==="cancelled").length,totalCompletedValue:total,averagePurchaseValue:completed.length?round(total/completed.length):0};}
+export class SupabasePurchaseRepository implements PurchaseRepository{
+ async list(filters:PurchaseFilters):Promise<PaginatedResult<Purchase>>{let rows=filtered(await loadAll(),filters);rows.sort((a,b)=>{const av=filters.sortBy==="total"?a.total:filters.sortBy==="number"?a.number:a.purchaseDate,bv=filters.sortBy==="total"?b.total:filters.sortBy==="number"?b.number:b.purchaseDate,result=av<bv?-1:av>bv?1:0;return filters.sortDirection==="asc"?result:-result;});const totalItems=rows.length,totalPages=Math.max(1,Math.ceil(totalItems/filters.pageSize)),page=Math.min(Math.max(1,filters.page),totalPages);return{items:rows.slice((page-1)*filters.pageSize,page*filters.pageSize),page,pageSize:filters.pageSize,totalItems,totalPages,hasPreviousPage:page>1,hasNextPage:page<totalPages};}
+ async getById(purchaseId:string|number){const purchase=(await loadAll()).find(p=>p.id===purchaseId);if(!purchase)throw new Error("Compra não encontrada.");return purchase;}
+ private async save(input:CreatePurchaseInput,purchaseId?:string|number){const id=await companyId();const {data,error}=await supabase.rpc("save_purchase",{p_company_id:id,p_purchase_id:purchaseId?String(purchaseId):null,p_supplier_id:String(input.supplierId),p_document_number:input.documentNumber??"",p_purchase_date:input.purchaseDate,p_items:input.items.map(item=>({product_id:item.productId,quantity:item.quantity,unit_cost:item.unitCost})),p_discount:input.discount??0,p_freight:input.freight??0,p_other_expenses:input.otherExpenses??0,p_notes:input.notes??""});if(error)throw error;if(!data)throw new Error("A compra não foi salva.");return this.getById(data.id);}
+ create(input:CreatePurchaseInput){return this.save(input);}
+ update(input:UpdatePurchaseInput){return this.save(input,input.purchaseId);}
+ async complete(input:CompletePurchaseInput){const id=await companyId(),settings=settingsStorageService.read();const {data,error}=await supabase.rpc("complete_purchase",{p_company_id:id,p_purchase_id:String(input.purchaseId),p_update_purchase_price:settings.inventory.updatePurchasePriceOnEntry});if(error)throw error;if(!data)throw new Error("A compra não foi concluída.");return this.getById(data.id);}
+ async cancel(input:CancelPurchaseInput){const id=await companyId();const {data,error}=await supabase.rpc("cancel_purchase",{p_company_id:id,p_purchase_id:String(input.purchaseId),p_reason:input.reason});if(error)throw error;if(!data)throw new Error("A compra não foi cancelada.");return this.getById(data.id);}
+ async getSummary(filters?:Partial<PurchaseFilters>){return summary(filtered(await loadAll(),filters));}
+}
