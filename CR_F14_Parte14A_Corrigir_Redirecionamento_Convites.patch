diff --git a/src/config/publicAppUrl.test.ts b/src/config/publicAppUrl.test.ts
new file mode 100644
index 0000000..a3ff786
--- /dev/null
+++ b/src/config/publicAppUrl.test.ts
@@ -0,0 +1,32 @@
+import {
+  describe,
+  expect,
+  it,
+} from "vitest";
+
+import {
+  resolvePublicAppUrl,
+} from "./publicAppUrl";
+
+describe("resolvePublicAppUrl", () => {
+  it("prioriza a URL pública configurada", () => {
+    expect(
+      resolvePublicAppUrl(
+        "https://gestor.exemplo.com/",
+        "http://localhost:5173",
+      ),
+    ).toBe("https://gestor.exemplo.com");
+  });
+
+  it("não envia convites para o ambiente local", () => {
+    expect(
+      resolvePublicAppUrl(undefined, "http://localhost:5173"),
+    ).toBe("https://cr-three-ashy.vercel.app");
+  });
+
+  it("mantém a origem pública atual quando não existe configuração", () => {
+    expect(
+      resolvePublicAppUrl(undefined, "https://app.exemplo.com"),
+    ).toBe("https://app.exemplo.com");
+  });
+});
diff --git a/src/config/publicAppUrl.ts b/src/config/publicAppUrl.ts
new file mode 100644
index 0000000..43c9b36
--- /dev/null
+++ b/src/config/publicAppUrl.ts
@@ -0,0 +1,35 @@
+const PRODUCTION_APP_URL = "https://cr-three-ashy.vercel.app";
+
+function normalizeUrl(value: string) {
+  return value.trim().replace(/\/+$/, "");
+}
+
+export function resolvePublicAppUrl(
+  configuredUrl: string | undefined,
+  currentOrigin: string,
+) {
+  if (configuredUrl?.trim()) {
+    return normalizeUrl(configuredUrl);
+  }
+
+  const currentUrl = new URL(currentOrigin);
+
+  if (
+    currentUrl.hostname === "localhost" ||
+    currentUrl.hostname === "127.0.0.1" ||
+    currentUrl.hostname.endsWith(".local")
+  ) {
+    return PRODUCTION_APP_URL;
+  }
+
+  return normalizeUrl(currentOrigin);
+}
+
+export function getPasswordSetupUrl() {
+  const appUrl = resolvePublicAppUrl(
+    import.meta.env.VITE_PUBLIC_APP_URL,
+    window.location.origin,
+  );
+
+  return `${appUrl}/definir-senha`;
+}
